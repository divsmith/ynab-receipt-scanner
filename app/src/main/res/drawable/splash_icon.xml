        <path
            android:strokeColor="#4A8BB5"
            android:strokeWidth="2"
            android:pathData="M10,12 L44,12" />
        <path
            android:strokeColor="#4A8BB5"
            android:strokeWidth="2"
            android:pathData="M10,20 L35,20" />
        <path
            android:strokeColor="#4A8BB5"
            android:strokeWidth="2"
