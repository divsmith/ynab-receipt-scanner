        <path
            android:strokeColor="#005A8C"
            android:strokeWidth="3"
            android:pathData="M6,46 L48,46" />
        
        <!-- Total amount box -->
        <path
            android:fillColor="#005A8C"
            android:pathData="M10,52 L44,52 L44,60 L10,60 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15,54 L17,54 L17,58 L15,58 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M19,54 L21,54 L21,58 L19,58 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M23,54 L25,54 L25,58 L23,58 Z" />
