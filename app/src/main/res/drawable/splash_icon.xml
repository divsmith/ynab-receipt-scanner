        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,0 L4,2 L4,0 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M50,0 L54,2 L50,0 Z" />
        
        <!-- Receipt tear at bottom -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M4,66 L7,63 L10,66 L13,63 L16,66 L19,63 L22,66 L25,63 L28,66 L31,63 L34,66 L37,63 L40,66 L43,63 L46,66 L50,66 Z" />
        
