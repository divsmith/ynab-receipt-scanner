<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Sync Icon -->
            <ImageView
                android:id="@+id/syncIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sync"
                android:tint="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/syncText"
                tools:ignore="ContentDescription" />

            <!-- Sync Status Text -->
            <TextView
                android:id="@+id/syncText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="Synced"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toEndOf="@id/syncIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/pendingBadge" />

            <!-- Last Sync Time -->
            <TextView
                android:id="@+id/lastSyncTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="Last sync: 5 minutes ago"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/syncIcon"
                app:layout_constraintTop_toBottomOf="@id/syncText"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible" />

            <!-- Pending Badge -->
            <com.google.android.material.chip.Chip
                android:id="@+id/pendingBadge"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="12sp"
                android:visibility="gone"
                app:chipMinHeight="24dp"
                app:chipBackgroundColor="?attr/colorErrorContainer"
                app:chipStrokeWidth="0dp"
                app:layout_constraintEnd_toStartOf="@id/connectivityBadge"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- Connectivity Badge -->
            <TextView
                android:id="@+id/connectivityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="📱"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</merge>
