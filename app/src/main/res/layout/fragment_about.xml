<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- App Icon and Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:id="@+id/image_app_icon"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/cd_app_icon" />

            <TextView
                android:id="@+id/text_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Version 1.0.0 (1)" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/text_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/about_description"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="?attr/colorOutlineVariant" />

        <!-- Information Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_information"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Privacy Policy Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_privacy_policy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_privacy_policy"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_privacy_policy"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="start" />

        <!-- Terms of Service Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_terms_of_service"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_terms_of_service"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_terms"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="start" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="?attr/colorOutlineVariant" />

        <!-- Open Source Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_open_source"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- GitHub Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_github"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_view_on_github"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_github"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="start" />

        <!-- Licenses Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_licenses"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_open_source_licenses"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_licenses"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="start" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="?attr/colorOutlineVariant" />

        <!-- Support Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_support"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Contact Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_contact"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_contact_support"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_contact"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="start" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="?attr/colorOutlineVariant" />

        <!-- YNAB Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_ynab"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- YNAB Website Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_ynab_website"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_ynab_website"
            android:gravity="start|center_vertical"
            android:contentDescription="@string/cd_about_ynab"
            app:icon="@drawable/ic_home"
            app:iconGravity="start" />

        <!-- Disclaimer -->
        <TextView
            android:id="@+id/text_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/about_disclaimer"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="@dimen/spacing_sm" />

        <!-- Copyright -->
        <TextView
            android:id="@+id/text_copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/about_copyright"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
